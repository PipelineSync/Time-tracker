# Supabase connection for the web, PWA, iOS, Android and desktop builds.
# Copy to .env and fill in from Supabase → Settings → API.
# These are baked in at BUILD time for every shell, so native apps must be
# rebuilt (npm run build && npx cap sync) after changing them.
#
# Never put the Supabase SECRET/service-role key in a VITE_* variable —
# it bypasses Row Level Security. The secret belongs only in Netlify's
# server-side environment (SUPABASE_SECRET_KEY) for the Netlify Functions.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-SB-PUBLISHABLE-KEY

# Optional: Slack incoming webhook used by the slack-notify Netlify Function
# for clock in / clock out / break / payment-paid notifications. Server-only —
# never expose it in a VITE_* variable. You can also configure (and override)
# this per workspace in the app under Settings → Slack.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXXXXXXXXX

# --- USD -> PHP reference rate -------------------------------------------
# API key for CurrencyFreaks, the primary rate feed the sync-fx-rate Netlify
# Function reads twice a day. Server-only, exactly like the secret key above:
# in a VITE_* variable it would ship in the browser bundle and anyone could
# spend your monthly request quota. Get one free at https://currencyfreaks.com
# (1,000 requests a month; two syncs a day use 60).
#
# Leaving this unset is supported — the sync then falls back to two keyless
# public feeds, which refresh once a day instead of on this schedule.
# Set it in Netlify → Project configuration → Environment variables.
CURRENCYFREAKS_API_KEY=

# --- Seasonal theme -------------------------------------------------------
# The Christmas skin (Santa hat on the logo, red/green palette, falling snow)
# is ON by default. Set this to `off` to build with the normal brand theme.
# VITE_CHRISTMAS_THEME=off
