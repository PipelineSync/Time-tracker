android/capacitor-cordova-android-plugins/build/
android/local.properties
android/**/*.keystore
ios/App/build/
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/DerivedData/
ios/**/*.xcarchive
ios/**/*.ipa
ios/App/App/Generated.xcconfig.bak

# --- Desktop shell (Tauri) ----------------------------------------------
src-tauri/target/
src-tauri/gen/schemas/
