# Netlify cache headers.
#
# Egress: without these, a returning visitor re-downloads the whole bundle on
# every visit. Vite fingerprints every file in /assets (index-CwjJ9514.js), so
# those URLs are safe to cache forever — a new build produces a new URL. The
# HTML entry point must NOT be cached, or browsers would keep booting an old
# build that points at deleted asset URLs.

# Fingerprinted build output — immutable, cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Brand images and PWA icons are not fingerprinted, so use a shorter TTL with
# revalidation: cached for a day, then a cheap 304 instead of a re-download.
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/pwa/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Entry point and service worker: always revalidate so a deploy is picked up
# immediately (both are small, and 304s cost almost nothing).
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# Security headers (no egress impact, but cheap to set correctly here).
# Deliberately no X-Frame-Options: the app is embedded in preview iframes
# during development, and it is not a clickjacking-sensitive surface.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Content-Security-Policy — the app's external origins are Supabase
  # (REST/Auth/Storage, *.supabase.co), hooks.slack.com (demo-mode Slack
  # posts straight from the browser; deployed builds post via the
  # server-side slack-notify function instead) and the two keyless USD → PHP
  # rate providers below. The rate providers have to be allowed here because
  # the browser fetches a fresh rate directly when the workspace has no
  # server-side sync to rely on (demo mode, non-Netlify hosts) and when the
  # admin clicks "Refresh now" in Settings → General — without them the CSP
  # blocks the request and the chip keeps the bundled fallback for ever.
  # Fonts are self-hosted (@fontsource), images are same-origin + data:
  # (avatars, QR codes), and the pre-paint theme script lives in
  # /theme-init.js so no 'unsafe-inline' is needed anywhere.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co https://hooks.slack.com https://open.er-api.com https://api.frankfurter.dev; object-src 'none'; base-uri 'self'; form-action 'self'
