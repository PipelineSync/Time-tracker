{
  "name": "work-tracker-extension",
  "private": true,
  "version": "1.0.0",
  "description": "Chrome extension for workers: clock in, start/end break, clock out \u2014 against the same Supabase workspace as the Work Tracker web app.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "zip": "node scripts/zip.mjs",
    "verify": "tsx scripts/verify-clock.ts",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:chrome": "node scripts/verify-chrome.mjs",
    "verify:all": "npm run verify && npm run verify:build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
